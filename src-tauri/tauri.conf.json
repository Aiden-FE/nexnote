{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexNote",
  "version": "0.0.37",
  "identifier": "dev.nexnote.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @nexnote/renderer dev",
    "beforeBuildCommand": "pnpm --filter @nexnote/renderer build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../packages/renderer/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NexNote",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:5173 http://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/git/"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5RTU4OEQwNzlBNjNGQkEKUldTNlA2WjUwSWpsdWNYcVlLaHFhQTFsT1dwckhPUW15M2VseTc1OUc5aFYvNWQzRkc4OXRxNXUK",
      "endpoints": [
        "https://github.com/Aiden-FE/nexnote/releases/download/tauri-v0.0.37.1/latest.json"
      ]
    }
  }
}
